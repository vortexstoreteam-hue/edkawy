        incoming().orderId == orderId &&
        incoming().customerId == request.auth.uid &&
        incoming().status in ['pending', 'confirmed', 'pending_payment', 'awaiting_pharmacy_quote', 'awaiting_courier_quote'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          existsAfter(/databases/$(database)/documents/orders/$(orderId)) ||
          exists(/databases/$(database)/documents/orders/$(orderId)) ||
          isAdmin()
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(orderId) &&
        isValidDispatchTicket(incoming()) &&
        incoming().orderId == existing().orderId &&
        incoming().customerId == existing().customerId &&
        incoming().storeId == existing().storeId &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          (
            ('storeOwnerId' in existing()
              ? ('storeOwnerId' in incoming() && incoming().storeOwnerId == existing().storeOwnerId)
              : !('storeOwnerId' in incoming())) &&
            isAllowedDispatchTransition(incoming(), existing(), incoming().diff(existing()).affectedKeys()) &&
            !isBlockedUserEntry()
          ) ||
          isOperationsOrAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(orderId) && isAdmin();
    }

    // Collection: /reviews/{orderId}
    match /reviews/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId);

      allow list: if isSignedIn() && (
        existing().storeRating in [1, 2, 3, 4, 5] ||
        existing().customerId == request.auth.uid ||
        (existing().storeRating >= 1 && existing().storeRating <= 5)
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(orderId) &&
        isValidReview(incoming()) &&
        incoming().orderId == orderId &&
        incoming().customerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        !isUserBlocked() &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        isDeliveredOrderOwnedBy(
          get(/databases/$(database)/documents/orders/$(orderId)).data,
          request.auth.uid
        )
      );

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(orderId) && isAdmin();
    }

    function isDeliveredOrderOwnedBy(orderData, uid) {
      return orderData.get('customerId', '') == uid &&
        orderData.get('status', '') == 'delivered';
    }

    // Collection: /ads/{adId}
    match /ads/{adId} {
      allow get: if isSignedIn() && isValidId(adId) && (
        resource == null ||
        existing().isActive in [true, false] ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().isActive in [true, false]
      );

      allow create: if (
        isSignedIn() &&
        isValidId(adId) &&
        isValidAdBanner(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(adId) &&
        isValidAdBanner(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(adId) && isAdmin();
    }

    // Collection: /coupons/{couponId}
    match /coupons/{couponId} {
      allow get: if isSignedIn() && isValidId(couponId);

      allow list: if isSignedIn() && (
        existing().isActive in [true, false] ||
        existing().createdBy == request.auth.uid
      );

      allow create: if (
        isSignedIn() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().code == couponId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isNonAnonymousUser() &&
            'ownerUid' in incoming() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().discountPercent <= 50 &&
            incoming().maxDiscountEgp <= 200 &&
            (!('isUsed' in incoming()) || incoming().isUsed == false)
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isNonAnonymousUser() &&
            !('isUsed' in existing() && existing().isUsed == true) &&
            'isUsed' in incoming() &&
            incoming().isUsed == true &&
            'usedBy' in incoming() &&
            incoming().usedBy == request.auth.uid &&
            incoming().isActive == false &&
            ('ownerUid' in existing() ? existing().ownerUid == request.auth.uid : true) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isUsed',
              'usedBy',
              'isActive',
              'updatedAt'
            ]) &&
            !isBlockedUserEntry()
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(couponId) && isAdmin();
    }

    // Collection: /notifications/{notificationId}
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        resource == null ||
        existing().recipientUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().recipientUid == request.auth.uid
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().isRead == false &&
        incoming().createdAt == request.time
      );

      allow update: if (
        isSignedIn() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt && (
          (
            existing().recipientUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(notificationId) && (
        isAdmin() ||
        existing().get('recipientUid', '') == request.auth.uid
      );
    }

    // Collection: /broadcastNotifications/{broadcastId} (Internal Admin Broadcasts)
    match /broadcastNotifications/{broadcastId} {
      allow get: if isSignedIn() && isValidId(broadcastId);

      allow list: if isSignedIn() && (
        existing().audience in ['all', 'customer', 'store', 'courier']
      );

      allow create: if (
        isSignedIn() &&
        isValidId(broadcastId) &&
        isValidBroadcastNotification(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin()
      );

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(broadcastId) && isAdmin();
    }

    // Collection: /campaigns/{campaignId} (Rotating Gamification Campaigns)
    match /campaigns/{campaignId} {
      allow get: if isSignedIn() && isValidId(campaignId);

      allow list: if isSignedIn() && (
        existing().isActive in [true, false]
      );

      allow create: if (
        isSignedIn() &&
        isValidId(campaignId) &&
        isValidCampaign(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(campaignId) &&
        isValidCampaign(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(campaignId) && isAdmin();
    }

    // Collection: /sharedCarts/{cartId} (Collaborative Group Order Carts)
    match /sharedCarts/{cartId} {
      allow get: if isSignedIn() && isValidId(cartId);
      allow list: if isSignedIn() && request.query.limit != null && request.query.limit <= 1;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(cartId) &&
        isValidSharedCart(incoming()) &&
        incoming().hostUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time
      );

      allow update: if (
        isSignedIn() &&
        isValidId(cartId) &&
        isValidSharedCart(incoming()) &&
        incoming().hostUid == existing().hostUid &&
        incoming().storeId == existing().storeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'open' && (
          incoming().status == 'open' ||
          incoming().hostUid == request.auth.uid
        )
      );

      allow delete: if isSignedIn() && isValidId(cartId) && (
        isAdmin() ||
        existing().get('hostUid', '') == request.auth.uid
      );
    }

    // Collection: /store_join_requests/{requestId}
    match /store_join_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        resource == null ||
        ('ownerUid' in existing() && existing().ownerUid == request.auth.uid)
      );

      allow list: if isSignedIn() && isAdmin();

      allow create: if isValidId(requestId) &&
        isValidStoreJoinRequest(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(requestId) &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }

    // Collection: /chat_logs/{logId} (Edkawy AI Assistant Logs)
    match /chat_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid
      );

      allow create: if (
        isSignedIn() &&
        isValidId(logId) &&
        isValidChatLog(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time
      );

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(logId) && isAdmin();
    }

    // Collection: /registeredAccounts/{emailHash}
    match /registeredAccounts/{emailHash} {
      allow get: if isValidHexHash(emailHash);
      allow list: if false;
      allow create, update: if (
        isNonAnonymousUser() &&
        isValidHexHash(emailHash) &&
        isValidRegisteredAccount(incoming()) &&
        incoming().updatedAt == request.time
      );
      allow delete: if isSignedIn() && isValidHexHash(emailHash);
    }

    // Collection: /passwordResetLocks/{emailHash} (Audit timestamp without cooldown lock)
    match /passwordResetLocks/{emailHash} {
      allow get: if isValidHexHash(emailHash);
      allow list: if false;
      allow create, update: if (
        isValidHexHash(emailHash) &&
        isValidPasswordResetLock(incoming()) &&
        incoming().updatedAt == request.time
      );
      allow delete: if isSignedIn() && isValidHexHash(emailHash) && isAdmin();
    }

    // Collection: /blockedUsers/{targetId} (Admin-managed account & store suspension registry)
    match /blockedUsers/{targetId} {
      allow get: if isSignedIn() && isValidId(targetId) && (
        resource == null ||
        request.auth.uid == targetId ||
        existing().targetType == 'store' ||
        isStoreOwnerOf(targetId) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().isBlocked in [true, false]
      );

      allow create: if (
        isSignedIn() &&
        isValidId(targetId) &&
        isValidBlockedEntity(incoming()) &&
        incoming().targetId == targetId &&
        incoming().blockedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(targetId) &&
        isValidBlockedEntity(incoming()) &&
        incoming().targetId == existing().targetId &&
        incoming().targetType == existing().targetType &&
        incoming().blockedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'targetName',
          'reason',
          'isBlocked',
          'blockedBy',
          'updatedAt'
        ]) &&
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(targetId) && isAdmin();
    }

    // Blueprint Validation Helpers: Staff & Technical Support System
    function isValidStaffMember(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'email',
        'role',
        'isActive',
        'openTicketCount',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'email',
        'role',
        'isActive',
        'openTicketCount',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
      data.role is string && data.role.size() <= 20 &&
      data.role in ['super_admin', 'support_agent', 'operations'] &&
      data.isActive is bool &&
      data.openTicketCount is number && data.openTicketCount >= 0 && data.openTicketCount <= 100000 &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSupportAgentPoolEntry(data) {
      return data.keys().hasAll([
        'staffId',
        'name',
        'isActive',
        'openTicketCount',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'staffId',
        'name',
        'isActive',
        'openTicketCount',
        'updatedAt'
      ]) &&
      isValidId(data.staffId) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.isActive is bool &&
      data.openTicketCount is number && data.openTicketCount >= 0 && data.openTicketCount <= 100000 &&
      data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
        'userId',
        'userName',
        'userPhone',
        'userRole',
        'subject',
        'category',
        'details',
        'status',
        'assignedTo',
        'assignedToName',
        'hasAdminReply',
        'createdAt',
        'lastUpdated'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'userName',
        'userPhone',
        'userEmail',
        'userRole',
        'subject',
        'category',
        'details',
        'status',
        'assignedTo',
        'assignedToName',
        'hasAdminReply',
        'attachmentImageUrl',
        'slaDeadlineIso',
        'createdAt',
        'lastUpdated'
      ]) &&
      isValidId(data.userId) &&
      data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
      data.userPhone is string && data.userPhone.size() <= 20 &&
      ('userEmail' in data ? (data.userEmail is string && data.userEmail.size() <= 100) : true) &&
      data.userRole is string && data.userRole.size() <= 20 &&
      data.userRole in ['customer', 'store', 'courier'] &&
      data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 100 &&
      data.category is string && data.category.size() <= 30 &&
      data.category in ['طلب', 'دفع', 'مشكلة تقنية', 'أخرى'] &&
      data.details is string && data.details.size() >= 6 && data.details.size() <= 1000 &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['open', 'closed'] &&
      data.assignedTo is string && data.assignedTo.size() <= 128 &&
      data.assignedToName is string && data.assignedToName.size() <= 80 &&
      data.hasAdminReply is bool &&
      (!('attachmentImageUrl' in data) || isValidUploadedImage(data.attachmentImageUrl)) &&
      (!('slaDeadlineIso' in data) || (data.slaDeadlineIso is string && data.slaDeadlineIso.size() <= 40)) &&
      data.createdAt is timestamp &&
      data.lastUpdated is timestamp;
    }

    function isValidSupportTicketIndex(data) {
      return data.keys().hasAll([
        'ticketId',
        'userId',
        'subject',
        'category',
        'status',
        'assignedTo',
        'assignedToName',
        'hasAdminReply',
        'createdAt',
        'lastUpdated'
      ]) &&
      data.keys().hasOnly([
        'ticketId',
        'userId',
        'subject',
        'category',
        'status',
        'assignedTo',
        'assignedToName',
        'hasAdminReply',
        'slaDeadlineIso',
        'createdAt',
        'lastUpdated'
      ]) &&
      isValidId(data.ticketId) &&
      isValidId(data.userId) &&
      data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 100 &&
      data.category is string && data.category.size() <= 30 &&
      data.category in ['طلب', 'دفع', 'مشكلة تقنية', 'أخرى'] &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['open', 'closed'] &&
      data.assignedTo is string && data.assignedTo.size() <= 128 &&
      data.assignedToName is string && data.assignedToName.size() <= 80 &&
      data.hasAdminReply is bool &&
      (!('slaDeadlineIso' in data) || (data.slaDeadlineIso is string && data.slaDeadlineIso.size() <= 40)) &&
      data.createdAt is timestamp &&
      data.lastUpdated is timestamp;
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll([
        'ticketId',
        'senderId',
        'senderName',
        'senderRole',
        'text',
        'participants',
        'timestamp'
      ]) &&
      data.keys().hasOnly([
        'ticketId',
        'senderId',
        'senderName',
        'senderRole',
        'text',
        'participants',
        'timestamp'
      ]) &&
      isValidId(data.ticketId) &&
      isValidId(data.senderId) &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
      data.senderRole is string && data.senderRole.size() <= 20 &&
      data.senderRole in ['user', 'admin', 'support_agent'] &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 1500 &&
      data.participants is list &&
      data.participants.size() >= 1 &&
      data.participants.size() <= 5 &&
      data.participants[0] is string &&
      data.participants[0].size() <= 128 &&
      data.timestamp is timestamp;
    }

    // Collection: /staff/{staffId} (Super-Admin Managed Internal Team)
    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && (
        request.auth.uid == staffId ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().createdBy == request.auth.uid ||
        existing().id == request.auth.uid
      );

      allow create: if (
        isSignedIn() &&
        isValidId(staffId) &&
        isValidStaffMember(incoming()) &&
        incoming().id == staffId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(staffId) &&
        isValidStaffMember(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isSupportStaff() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['openTicketCount', 'updatedAt'])
          )
        )
      );

      allow delete: if isSignedIn() && isValidId(staffId) && isAdmin();
    }

    // Collection: /supportAgentsPool/{staffId} (Non-PII Workload Pool for Auto-Assignment)
    match /supportAgentsPool/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId);

      allow list: if isSignedIn() && (
        existing().isActive in [true, false]
      );

      allow create: if (
        isSignedIn() &&
        isValidId(staffId) &&
        isValidSupportAgentPoolEntry(incoming()) &&
        incoming().staffId == staffId &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(staffId) &&
        isValidSupportAgentPoolEntry(incoming()) &&
        incoming().staffId == existing().staffId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          isSupportStaff() ||
          (
            isNonAnonymousUser() &&
            incoming().name == existing().name &&
            incoming().isActive == existing().isActive &&
            incoming().openTicketCount == existing().openTicketCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['openTicketCount', 'updatedAt'])
          )
        )
      );

      allow delete: if isSignedIn() && isValidId(staffId) && isAdmin();
    }

    // Collection: /support_tickets/{ticketId} (PII-Isolated Technical Support Tickets)
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (
        resource == null ||
        existing().userId == request.auth.uid ||
        existing().assignedTo == request.auth.uid ||
        isSupportStaff() ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        existing().assignedTo == request.auth.uid
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().hasAdminReply == false &&
        incoming().createdAt == request.time &&
        incoming().lastUpdated == request.time &&
        existsAfter(/databases/$(database)/documents/supportTicketIndex/$(ticketId))
      );

      allow update: if (
        isSignedIn() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastUpdated == request.time && (
          // Action 1: Ticket Owner updates timestamp on follow-up message or closes own ticket
          (
            existing().userId == request.auth.uid &&
            existing().status == 'open' &&
            incoming().status in ['open', 'closed'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdated'])
          ) ||
          // Action 2: Assigned Support Agent or Support Staff replies or closes ticket
          (
            (existing().assignedTo == request.auth.uid || isSupportStaff()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'hasAdminReply',
              'assignedTo',
              'assignedToName',
              'lastUpdated'
            ])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    // Collection: /supportTicketIndex/{ticketId} (Non-PII Live Index for Admin Support Workspace)
    match /supportTicketIndex/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId);

      allow list: if isSignedIn() && (
        existing().status in ['open', 'closed']
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(ticketId) &&
        isValidSupportTicketIndex(incoming()) &&
        incoming().ticketId == ticketId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().hasAdminReply == false &&
        incoming().createdAt == request.time &&
        incoming().lastUpdated == request.time &&
        existsAfter(/databases/$(database)/documents/support_tickets/$(ticketId))
      );

      allow update: if (
        isSignedIn() &&
        isValidId(ticketId) &&
        isValidSupportTicketIndex(incoming()) &&
        incoming().ticketId == existing().ticketId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastUpdated == request.time && (
          (
            existing().userId == request.auth.uid &&
            existing().status == 'open' &&
            incoming().status in ['open', 'closed'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdated'])
          ) ||
          (
            (existing().assignedTo == request.auth.uid || isSupportStaff()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'hasAdminReply',
              'assignedTo',
              'assignedToName',
              'lastUpdated'
            ])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    // Collection: /support_messages/{messageId} (Real-Time Live Chat Bubble Stream)
    match /support_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        resource == null ||
        request.auth.uid in existing().participants ||
        isSupportOrAdmin()
      );

      allow list: if isSignedIn() && (
        request.auth.uid in existing().participants
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().senderId == request.auth.uid &&
        request.auth.uid in incoming().participants &&
        incoming().timestamp == request.time &&
        exists(/databases/$(database)/documents/support_tickets/$(incoming().ticketId)) && (
          (
            incoming().senderRole == 'user' &&
            get(/databases/$(database)/documents/support_tickets/$(incoming().ticketId)).data.get('userId', '') == request.auth.uid
          ) ||
          (
            incoming().senderRole in ['admin', 'support_agent'] &&
            isSupportOrAdmin()
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().ticketId == existing().ticketId &&
        incoming().senderId == existing().senderId &&
        incoming().text == existing().text &&
        incoming().timestamp == existing().timestamp &&
        incoming().diff(existing()).affectedKeys().hasOnly(['participants']) &&
        isSupportOrAdmin()
      );
      allow delete: if isSignedIn() && isValidId(messageId) && isAdmin();
    }

    // Blueprint Validation Helper: AuditLog (/audit_logs/{logId})
    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'adminId',
        'adminName',
        'actionType',
        'actionLabelAr',
        'details',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'adminId',
        'adminName',
        'actionType',
        'actionLabelAr',
        'details',
        'targetId',
        'createdAt'
      ]) &&
      isBoundedId(data.adminId) &&
      data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 80 &&
      data.actionType is string && data.actionType.size() <= 40 &&
      data.actionType in [
        'ban_customer',
        'unban_customer',
        'block_entity',
        'unblock_entity',
        'update_delivery_fee',
        'approve_store',
        'toggle_store_active',
        'approve_courier',
        'delete_product',
        'delete_ad_banner',
        'delete_coupon',
        'delete_campaign',
        'send_notification',
        'toggle_maintenance',
        'gift_points',
        'purge_test_data',
        'update_zone_price',
        'manage_category',
        'create_invitation',
        'send_invitation',
        'resend_invitation',
        'delete_invitation',
        'create_sales_agent',
        'manage_sales_agent',
        'approve_payout',
        'reject_payout',
        'handle_payout',
        'admin_password_reset_link',
        'reset_user_password',
        'admin_update_login_email',
        'update_user_email',
        'approve_wallet_topup',
        'reject_wallet_topup',
        'update_system_settings'
      ] &&
      data.actionLabelAr is string && data.actionLabelAr.size() >= 2 && data.actionLabelAr.size() <= 80 &&
      data.details is string && data.details.size() >= 2 && data.details.size() <= 500 &&
      ('targetId' in data ? isBoundedId(data.targetId) : true) &&
      data.createdAt is timestamp;
    }

    // Collection: /audit_logs/{logId} (Immutable Admin Security Audit Trail)
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if false;
      allow create: if (
        isNonAnonymousUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().adminId == request.auth.uid &&
        incoming().createdAt == request.time &&
        (isOperationsOrAdmin() || isSupportOrAdmin() || isAdmin())
      );
      allow update, delete: if false;
    }

    // Blueprint Validation Helper: EdkoZone (/edko_zones/{zoneId})
    function isValidEdkoZone(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'distanceLabel',
        'price',
        'neighborhoods',
        'description',
        'sortOrder',
        'isActive',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'distanceLabel',
        'price',
        'neighborhoods',
        'description',
        'sortOrder',
        'isActive',
        'updatedBy',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() <= 20 &&
      data.id in ['zone_1', 'zone_2', 'zone_3', 'zone_4', 'zone_5'] &&
      data.name is string && data.name.size() >= 3 && data.name.size() <= 80 &&
      data.distanceLabel is string && data.distanceLabel.size() >= 2 && data.distanceLabel.size() <= 40 &&
      data.price is number && data.price >= 5 && data.price <= 250 &&
      data.neighborhoods is list && data.neighborhoods.size() >= 1 && data.neighborhoods.size() <= 25 &&
      data.neighborhoods[0] is string && data.neighborhoods[0].size() <= 80 &&
      data.description is string && data.description.size() >= 4 && data.description.size() <= 220 &&
      data.sortOrder is number && data.sortOrder >= 1 && data.sortOrder <= 10 &&
      data.isActive is bool &&
      ('updatedBy' in data ? isBoundedId(data.updatedBy) : true) &&
      data.updatedAt is timestamp;
    }

    function isCanonicalZoneDefault(zoneId, price) {
      return (zoneId == 'zone_1' && price == 15) ||
        (zoneId == 'zone_2' && price == 20) ||
        (zoneId == 'zone_3' && price == 25) ||
        (zoneId == 'zone_4' && price == 30) ||
        (zoneId == 'zone_5' && price == 35);
    }

    // Collection: /edko_zones/{zoneId} (Strictly 5 Approved Edku Geographical Zones)
    match /edko_zones/{zoneId} {
      allow get: if isSignedIn() && zoneId in ['zone_1', 'zone_2', 'zone_3', 'zone_4', 'zone_5'];
      allow list: if isSignedIn() && existing().isActive in [true, false];
      allow create: if (
        isNonAnonymousUser() &&
        zoneId in ['zone_1', 'zone_2', 'zone_3', 'zone_4', 'zone_5'] &&
        isValidEdkoZone(incoming()) &&
        incoming().id == zoneId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (incoming().isActive == true && isCanonicalZoneDefault(zoneId, incoming().price))
        )
      );
      allow update: if (
        isSignedIn() &&
        zoneId in ['zone_1', 'zone_2', 'zone_3', 'zone_4', 'zone_5'] &&
        isValidEdkoZone(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(zoneId) && isAdmin();
    }

    // Blueprint Validation Helper: Category (/categories/{categoryId})
    function isValidCategory(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'storeCategory',
        'icon',
        'isActive',
        'sortOrder',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'storeCategory',
        'icon',
        'isActive',
        'sortOrder',
        'updatedBy',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 2 && data.id.size() <= 40 &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 50 &&
      data.storeCategory is string && data.storeCategory.size() <= 40 &&
      data.storeCategory in [
        'أسماك وبحريات',
        'مشويات ومطاعم',
        'مخابز وفطائر',
        'سوبر ماركت',
        'صيدليات',
        'أكل بيتي',
        'مستحضرات تجميل',
        'أدوات منزلية',
        'ملابس',
        'هدايا وإكسسوارات'
      ] &&
      data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 32 &&
      data.isActive is bool &&
      data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 500 &&
      ('updatedBy' in data ? isBoundedId(data.updatedBy) : true) &&
      data.updatedAt is timestamp;
    }

    // Collection: /categories/{categoryId} (Dynamic Super App Categories)
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId);
      allow list: if isSignedIn() && existing().isActive in [true, false];
      allow create: if (
        isNonAnonymousUser() &&
        isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().id == categoryId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            categoryId in [
              'home_food',
              'cosmetics',
              'household',
              'clothing',
              'gifts',
              'seafood',
              'grills',
              'bakery',
              'supermarket',
              'pharmacy'
            ] &&
            incoming().isActive == true
          )
        )
      );
      allow update: if (
        isSignedIn() &&
        isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(categoryId) && isAdmin();
    }

    // Blueprint Validation Helpers: GroupSession (/group_sessions/{sessionId})
    function isValidGroupSession(data) {
      return data.keys().hasAll([
        'hostUid',
        'hostName',
        'storeId',
        'storeName',
        'storeDeliveryFee',
        'status',
        'participants',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'hostUid',
        'hostName',
        'storeId',
        'storeName',
        'storeDeliveryFee',
        'status',
        'participants',
        'participantNames',
        'createdAt',
        'updatedAt'
      ]) &&
      isBoundedId(data.hostUid) &&
      data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80 &&
      isBoundedId(data.storeId) &&
      data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100 &&
      data.storeDeliveryFee is number && data.storeDeliveryFee >= 0 && data.storeDeliveryFee <= 500 &&
      data.status is string && data.status.size() <= 20 &&
      data.status in ['open', 'checked_out', 'cancelled'] &&
      data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 25 &&
      data.participants[0] is string && data.participants[0].size() <= 128 &&
      (!('participantNames' in data) || (data.participantNames is map && data.participantNames.keys().size() <= 25)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGroupSessionCartItem(data) {
      return data.keys().hasAll([
        'entryId',
        'sessionId',
        'participantUid',
        'participantName',
        'productId',
        'name',
        'price',
        'quantity',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'entryId',
        'sessionId',
        'participantUid',
        'participantName',
        'productId',
        'variantId',
        'variantLabel',
        'name',
        'price',
        'quantity',
        'updatedAt'
      ]) &&
      isBoundedId(data.entryId) &&
      isBoundedId(data.sessionId) &&
      isBoundedId(data.participantUid) &&
      data.participantName is string && data.participantName.size() >= 1 && data.participantName.size() <= 80 &&
      isBoundedId(data.productId) &&
      (!('variantId' in data) || (data.variantId is string && data.variantId.size() <= 64)) &&
      (!('variantLabel' in data) || (data.variantLabel is string && data.variantLabel.size() <= 80)) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.price is number && data.price > 0 && data.price <= 20000 &&
      data.quantity is number && data.quantity >= 1 && data.quantity <= 50 &&
      data.updatedAt is timestamp;
    }

    function isValidGroupSessionChatMessage(data) {
      return data.keys().hasAll([
        'sessionId',
        'senderUid',
        'senderName',
        'text',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId',
        'senderUid',
        'senderName',
        'text',
        'createdAt'
      ]) &&
      isBoundedId(data.sessionId) &&
      isBoundedId(data.senderUid) &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
      data.createdAt is timestamp;
    }

    function isGroupSessionMember(sessionId) {
      return exists(/databases/$(database)/documents/group_sessions/$(sessionId)) &&
        request.auth.uid in get(/databases/$(database)/documents/group_sessions/$(sessionId)).data.get('participants', []);
    }

    function isGroupSessionOpenForMember(sessionId) {
      return exists(/databases/$(database)/documents/group_sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/group_sessions/$(sessionId)).data.get('status', '') == 'open' &&
        request.auth.uid in get(/databases/$(database)/documents/group_sessions/$(sessionId)).data.get('participants', []);
    }

    match /group_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId);
      allow list: if false;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(sessionId) &&
        isValidGroupSession(incoming()) &&
        incoming().hostUid == request.auth.uid &&
        request.auth.uid in incoming().participants &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        !isUserBlocked()
      );

      allow update: if (
        isSignedIn() &&
        isValidId(sessionId) &&
        isValidGroupSession(incoming()) &&
        incoming().hostUid == existing().hostUid &&
        incoming().storeId == existing().storeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        !isUserBlocked() && (
          (
            isNonAnonymousUser() &&
            existing().status == 'open' &&
            incoming().status == 'open' &&
            request.auth.uid in incoming().participants &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'participants',
              'participantNames',
              'updatedAt'
            ])
          ) ||
          (
            existing().hostUid == request.auth.uid &&
            existing().status == 'open' &&
            incoming().status in ['checked_out', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(sessionId) && (
        isAdmin() ||
        existing().get('hostUid', '') == request.auth.uid
      );

      match /cart/{itemId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(itemId) && isGroupSessionMember(sessionId);
        allow list: if isSignedIn() && isValidId(sessionId) && existing().sessionId == sessionId;

        allow create: if (
          isNonAnonymousUser() &&
          isValidId(sessionId) &&
          isValidId(itemId) &&
          isValidGroupSessionCartItem(incoming()) &&
          incoming().entryId == itemId &&
          incoming().sessionId == sessionId &&
          incoming().participantUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          !isUserBlocked() &&
          isGroupSessionOpenForMember(sessionId)
        );

        allow update: if (
          isNonAnonymousUser() &&
          isValidId(sessionId) &&
          isValidId(itemId) &&
          isValidGroupSessionCartItem(incoming()) &&
          incoming().entryId == existing().entryId &&
          incoming().sessionId == existing().sessionId &&
          incoming().participantUid == existing().participantUid &&
          incoming().productId == existing().productId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'quantity',
            'price',
            'participantName',
            'updatedAt'
          ]) &&
          !isUserBlocked() &&
          isGroupSessionOpenForMember(sessionId) && (
            existing().participantUid == request.auth.uid ||
            get(/databases/$(database)/documents/group_sessions/$(sessionId)).data.get('hostUid', '') == request.auth.uid
          )
        );

        allow delete: if (
          isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(itemId) &&
          isGroupSessionOpenForMember(sessionId) && (
            existing().participantUid == request.auth.uid ||
            get(/databases/$(database)/documents/group_sessions/$(sessionId)).data.get('hostUid', '') == request.auth.uid ||
            isAdmin()
          )
        );
      }

      match /chat/{messageId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) && isGroupSessionMember(sessionId);
        allow list: if isSignedIn() && isValidId(sessionId) && existing().sessionId == sessionId;

        allow create: if (
          isNonAnonymousUser() &&
          isValidId(sessionId) &&
          isValidId(messageId) &&
          isValidGroupSessionChatMessage(incoming()) &&
          incoming().sessionId == sessionId &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          !isUserBlocked() &&
          isGroupSessionMember(sessionId)
        );

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) && isAdmin();
      }
    }

    // =========================================================================
    // INVITATION MANAGEMENT, SALES AGENT CRM, COMMISSIONS & PAYOUT WALLET
    // =========================================================================

    function isValidInvitation(data) {
      return data.keys().hasAll([
        'id',
        'email',
        'userType',
        'token',
        'status',
        'expiresAtMs',
        'expiresAtIso',
        'invitedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'email',
        'userType',
        'token',
        'status',
        'expiresAtMs',
        'expiresAtIso',
        'invitedBy',
        'invitedByName',
        'invitedByRole',
        'agentId',
        'referralCode',
        'acceptedByUid',
        'acceptedAtIso',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
      data.userType is string && data.userType.size() <= 20 &&
      data.userType in ['store', 'customer', 'courier', 'sales_agent'] &&
      isValidId(data.token) && data.token.size() >= 16 &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['pending', 'accepted', 'expired'] &&
      data.expiresAtMs is number && data.expiresAtMs > 0 &&
      data.expiresAtIso is string && data.expiresAtIso.size() <= 40 &&
      isBoundedId(data.invitedBy) &&
      (!('invitedByName' in data) || (data.invitedByName is string && data.invitedByName.size() <= 80)) &&
      (!('invitedByRole' in data) || (data.invitedByRole is string && data.invitedByRole.size() <= 20 && data.invitedByRole in ['admin', 'sales_agent'])) &&
      (!('agentId' in data) || isBoundedId(data.agentId)) &&
      (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 24)) &&
      (!('acceptedByUid' in data) || isBoundedId(data.acceptedByUid)) &&
      (!('acceptedAtIso' in data) || (data.acceptedAtIso is string && data.acceptedAtIso.size() <= 40)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInvitationIndexEntry(data) {
      return data.keys().hasAll([
        'token',
        'maskedEmail',
        'userType',
        'status',
        'expiresAtMs',
        'expiresAtIso',
        'invitedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'token',
        'maskedEmail',
        'userType',
        'status',
        'expiresAtMs',
        'expiresAtIso',
        'invitedBy',
        'invitedByName',
        'invitedByRole',
        'referralCode',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.token) && data.token.size() >= 16 &&
      data.maskedEmail is string && data.maskedEmail.size() >= 3 && data.maskedEmail.size() <= 100 &&
      data.userType is string && data.userType.size() <= 20 &&
      data.userType in ['store', 'customer', 'courier', 'sales_agent'] &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['pending', 'accepted', 'expired'] &&
      data.expiresAtMs is number && data.expiresAtMs > 0 &&
      data.expiresAtIso is string && data.expiresAtIso.size() <= 40 &&
      isBoundedId(data.invitedBy) &&
      (!('invitedByName' in data) || (data.invitedByName is string && data.invitedByName.size() <= 80)) &&
      (!('invitedByRole' in data) || (data.invitedByRole is string && data.invitedByRole.size() <= 20 && data.invitedByRole in ['admin', 'sales_agent'])) &&
      (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 24)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInvitationLock(data) {
      return data.keys().hasAll(['token', 'status', 'expiresAtMs', 'invitedBy', 'updatedAt']) &&
        data.keys().hasOnly(['token', 'status', 'expiresAtMs', 'invitedBy', 'updatedAt']) &&
        isValidId(data.token) && data.token.size() >= 16 &&
        data.status is string && data.status.size() <= 16 &&
        data.status in ['pending', 'accepted', 'expired'] &&
        data.expiresAtMs is number && data.expiresAtMs > 0 &&
        isBoundedId(data.invitedBy) &&
        data.updatedAt is timestamp;
    }

    // Collection: /invitations/{token} (Single-use 48h invitation tokens)
    match /invitations/{token} {
      // Single-document lookup allowed ONLY with high-entropy >= 16-char token ID (for pre-registration verification)
      allow get: if isValidId(token) && token.size() >= 16;

      // Zero-get() list scoped strictly to the sender (Admin reads global queue via /invitationIndex + getDoc)
      allow list: if isSignedIn() && existing().invitedBy == request.auth.uid;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(token) &&
        token.size() >= 16 &&
        isValidInvitation(incoming()) &&
        incoming().id == token &&
        incoming().token == token &&
        incoming().status == 'pending' &&
        incoming().invitedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/invitationIndex/$(token)) && (
          isAdmin() ||
          (
            incoming().userType in ['store', 'customer', 'courier'] &&
            isActiveSalesAgent()
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(token) &&
        token.size() >= 16 &&
        isValidInvitation(incoming()) &&
        incoming().id == existing().id &&
        incoming().token == existing().token &&
        incoming().email == existing().email &&
        incoming().userType == existing().userType &&
        incoming().invitedBy == existing().invitedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Invitee accepts pending invitation during registration
          (
            isNonAnonymousUser() &&
            existing().status == 'pending' &&
            incoming().status == 'accepted' &&
            'acceptedByUid' in incoming() &&
            incoming().acceptedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'acceptedByUid',
              'acceptedAtIso',
              'updatedAt'
            ])
          ) ||
          // Action 2: Sender or Admin refreshes expiry on resend or marks expired
          (
            existing().status in ['pending', 'expired'] &&
            incoming().status in ['pending', 'expired'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expiresAtMs',
              'expiresAtIso',
              'updatedAt'
            ]) && (
              isAdmin() ||
              (existing().invitedBy == request.auth.uid && isActiveSalesAgent())
            )
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(token) && (
        isAdmin() ||
        (existing().invitedBy == request.auth.uid && isActiveSalesAgent())
      );
    }

    // Collection: /invitationIndex/{token} (Non-PII operational queue for Admin live monitoring)
    match /invitationIndex/{token} {
      allow get: if isSignedIn() && isValidId(token);
      allow list: if isSignedIn() && existing().status in ['pending', 'accepted', 'expired'];

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(token) &&
        token.size() >= 16 &&
        isValidInvitationIndexEntry(incoming()) &&
        incoming().token == token &&
        incoming().status == 'pending' &&
        incoming().invitedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/invitations/$(token)) && (
          isAdmin() ||
          (
            incoming().userType in ['store', 'customer', 'courier'] &&
            isActiveSalesAgent()
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(token) &&
        isValidInvitationIndexEntry(incoming()) &&
        incoming().token == existing().token &&
        incoming().userType == existing().userType &&
        incoming().invitedBy == existing().invitedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isNonAnonymousUser() &&
            existing().status == 'pending' &&
            incoming().status == 'accepted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            existing().status in ['pending', 'expired'] &&
            incoming().status in ['pending', 'expired'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expiresAtMs',
              'expiresAtIso',
              'updatedAt'
            ]) && (
              isAdmin() ||
              (existing().invitedBy == request.auth.uid && isActiveSalesAgent())
            )
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(token) && (
        isAdmin() ||
        (existing().invitedBy == request.auth.uid && isActiveSalesAgent())
      );
    }

    // Collection: /invitationLocks/{emailHash} (Duplicate active pending guard)
    match /invitationLocks/{emailHash} {
      allow get: if isValidHexHash(emailHash);
      allow list: if false;

      allow create, update: if (
        isNonAnonymousUser() &&
        isValidHexHash(emailHash) &&
        isValidInvitationLock(incoming()) &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          isActiveSalesAgent() ||
          incoming().status == 'accepted'
        )
      );

      allow delete: if isSignedIn() && isValidHexHash(emailHash) && (
        isAdmin() ||
        existing().invitedBy == request.auth.uid
      );
    }

    function isValidSalesAgent(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'email',
        'phone',
        'referralCode',
        'isActive',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'email',
        'phone',
        'referralCode',
        'isActive',
        'inviteToken',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
      isValidEgyptPhone(data.phone) &&
      data.referralCode is string && data.referralCode.size() >= 6 && data.referralCode.size() <= 24 &&
      data.isActive is bool &&
      (!('inviteToken' in data) || isBoundedId(data.inviteToken)) &&
      isBoundedId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSalesAgentDirectoryEntry(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'referralCode',
        'commissionRatePercent',
        'availableBalance',
        'pendingBalance',
        'totalEarnings',
        'invitedStoresCount',
        'invitedCustomersCount',
        'invitedCouriersCount',
        'isActive',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'name',
        'referralCode',
        'commissionRatePercent',
        'availableBalance',
        'pendingBalance',
        'totalEarnings',
        'invitedStoresCount',
        'invitedCustomersCount',
        'invitedCouriersCount',
        'isActive',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.referralCode is string && data.referralCode.size() >= 6 && data.referralCode.size() <= 24 &&
      data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 50 &&
      data.availableBalance is number && data.availableBalance >= 0 && data.availableBalance <= 10000000 &&
      data.pendingBalance is number && data.pendingBalance >= 0 && data.pendingBalance <= 10000000 &&
      data.totalEarnings is number && data.totalEarnings >= 0 && data.totalEarnings <= 50000000 &&
      data.invitedStoresCount is number && data.invitedStoresCount >= 0 && data.invitedStoresCount <= 100000 &&
      data.invitedCustomersCount is number && data.invitedCustomersCount >= 0 && data.invitedCustomersCount <= 1000000 &&
      data.invitedCouriersCount is number && data.invitedCouriersCount >= 0 && data.invitedCouriersCount <= 100000 &&
      data.isActive is bool &&
      isBoundedId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /sales_agents/{agentId} (PII-isolated Sales Agent Profile)
    match /sales_agents/{agentId} {
      allow get: if isSignedIn() && isValidId(agentId) && (
        request.auth.uid == agentId ||
        isAdmin()
      );
      allow list: if isSignedIn() && existing().id == request.auth.uid;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(agentId) &&
        isValidSalesAgent(incoming()) &&
        incoming().id == agentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/salesAgentDirectory/$(agentId)) && (
          isAdmin() ||
          (
            agentId == request.auth.uid &&
            incoming().createdBy == request.auth.uid &&
            incoming().isActive == true &&
            'inviteToken' in incoming() &&
            isValidPendingInviteAcceptance(incoming().inviteToken, 'sales_agent')
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(agentId) &&
        isValidSalesAgent(incoming()) &&
        incoming().id == existing().id &&
        incoming().referralCode == existing().referralCode &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            request.auth.uid == agentId &&
            incoming().email == existing().email &&
            incoming().isActive == existing().isActive &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(agentId) && (
        request.auth.uid == agentId ||
        isAdmin()
      );
    }

    // Collection: /salesAgentDirectory/{agentId} (Non-PII Commission Wallet & Stats)
    match /salesAgentDirectory/{agentId} {
      allow get: if isSignedIn() && isValidId(agentId);
      allow list: if isSignedIn() && existing().isActive in [true, false];

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(agentId) &&
        isValidSalesAgentDirectoryEntry(incoming()) &&
        incoming().id == agentId &&
        incoming().availableBalance == 0 &&
        incoming().pendingBalance == 0 &&
        incoming().totalEarnings == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/sales_agents/$(agentId)) && (
          isAdmin() ||
          (
            agentId == request.auth.uid &&
            incoming().createdBy == request.auth.uid &&
            incoming().commissionRatePercent == 5
          )
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(agentId) &&
        isValidSalesAgentDirectoryEntry(incoming()) &&
        incoming().id == existing().id &&
        incoming().referralCode == existing().referralCode &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Newly referred account increments referral counters
          (
            isNonAnonymousUser() &&
            incoming().commissionRatePercent == existing().commissionRatePercent &&
            incoming().availableBalance == existing().availableBalance &&
            incoming().pendingBalance == existing().pendingBalance &&
            incoming().totalEarnings == existing().totalEarnings &&
            incoming().invitedStoresCount >= existing().invitedStoresCount &&
            incoming().invitedCustomersCount >= existing().invitedCustomersCount &&
            incoming().invitedCouriersCount >= existing().invitedCouriersCount &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'invitedStoresCount',
              'invitedCustomersCount',
              'invitedCouriersCount',
              'updatedAt'
            ])
          ) ||
          // Action 2: Order delivery adds pending commission to 24h escrow
          (
            (isApprovedCourier() || isOperationsStaff() || isNonAnonymousUser()) &&
            incoming().commissionRatePercent == existing().commissionRatePercent &&
            incoming().availableBalance == existing().availableBalance &&
            incoming().pendingBalance > existing().pendingBalance &&
            incoming().totalEarnings > existing().totalEarnings &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pendingBalance',
              'totalEarnings',
              'updatedAt'
            ])
          ) ||
          // Action 3: Sales Agent settles matured 24h commission (pending -> available) or requests payout (>= 100 EGP)
          (
            request.auth.uid == agentId &&
            incoming().commissionRatePercent == existing().commissionRatePercent &&
            incoming().totalEarnings == existing().totalEarnings && (
              // Escrow release: total (available + pending) remains constant
              (
                incoming().availableBalance > existing().availableBalance &&
                incoming().pendingBalance < existing().pendingBalance &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'availableBalance',
                  'pendingBalance',
                  'updatedAt'
                ])
              ) ||
              // Payout withdrawal deduction (>= 100 EGP)
              (
                incoming().pendingBalance == existing().pendingBalance &&
                existing().availableBalance - incoming().availableBalance >= 100 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'availableBalance',
                  'updatedAt'
                ])
              )
            )
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(agentId) && (
        request.auth.uid == agentId ||
        isAdmin()
      );
    }

    function isValidReferralCodeEntry(data) {
      return data.keys().hasAll(['code', 'agentId', 'agentName', 'isActive', 'createdAt']) &&
        data.keys().hasOnly(['code', 'agentId', 'agentName', 'isActive', 'createdAt']) &&
        data.code is string && data.code.size() >= 6 && data.code.size() <= 24 &&
        isValidId(data.agentId) &&
        data.agentName is string && data.agentName.size() >= 2 && data.agentName.size() <= 80 &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    // Collection: /referralCodes/{code} (O(1) non-PII referral code lookup)
    match /referralCodes/{code} {
      allow get: if isValidId(code);
      allow list: if false;
      allow create, update: if (
        isNonAnonymousUser() &&
        isValidId(code) &&
        isValidReferralCodeEntry(incoming()) &&
        incoming().code == code && (
          isAdmin() ||
          incoming().agentId == request.auth.uid
        )
      );
      allow delete: if isSignedIn() && isValidId(code) && (
        isAdmin() ||
        existing().agentId == request.auth.uid
      );
    }

    function isValidReferralAccount(data) {
      return data.keys().hasAll([
        'id',
        'agentId',
        'referralCode',
        'referredUid',
        'accountName',
        'accountType',
        'status',
        'completedOrdersCount',
        'totalSalesVolumeEgp',
        'totalCommissionsEgp',
        'joinedAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'agentId',
        'referralCode',
        'referredUid',
        'referredStoreId',
        'accountName',
        'accountType',
        'status',
        'completedOrdersCount',
        'totalSalesVolumeEgp',
        'totalCommissionsEgp',
        'joinedAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.agentId) &&
      data.referralCode is string && data.referralCode.size() >= 6 && data.referralCode.size() <= 24 &&
      isValidId(data.referredUid) &&
      (!('referredStoreId' in data) || isBoundedId(data.referredStoreId)) &&
      data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 80 &&
      data.accountType is string && data.accountType.size() <= 20 &&
      data.accountType in ['store', 'customer', 'courier'] &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['active', 'inactive'] &&
      data.completedOrdersCount is number && data.completedOrdersCount >= 0 && data.completedOrdersCount <= 1000000 &&
      data.totalSalesVolumeEgp is number && data.totalSalesVolumeEgp >= 0 && data.totalSalesVolumeEgp <= 100000000 &&
      data.totalCommissionsEgp is number && data.totalCommissionsEgp >= 0 && data.totalCommissionsEgp <= 50000000 &&
      data.joinedAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /referrals/{referralId} (Non-PII CRM of referred accounts)
    match /referrals/{referralId} {
      allow get: if isSignedIn() && isValidId(referralId);
      allow list: if isSignedIn() && (
        existing().agentId == request.auth.uid ||
        existing().referredUid == request.auth.uid
      );

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(referralId) &&
        isValidReferralAccount(incoming()) &&
        incoming().id == referralId &&
        incoming().joinedAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/salesAgentDirectory/$(incoming().agentId)) && (
          incoming().referredUid == request.auth.uid ||
          isAdmin()
        )
      );

      allow update: if (
        isSignedIn() &&
        isValidId(referralId) &&
        isValidReferralAccount(incoming()) &&
        incoming().id == existing().id &&
        incoming().agentId == existing().agentId &&
        incoming().referredUid == existing().referredUid &&
        incoming().joinedAt == existing().joinedAt &&
        incoming().updatedAt == request.time && (
          (
            (isApprovedCourier() || isOperationsStaff() || isNonAnonymousUser()) &&
            incoming().completedOrdersCount >= existing().completedOrdersCount &&
            incoming().totalSalesVolumeEgp >= existing().totalSalesVolumeEgp &&
            incoming().totalCommissionsEgp >= existing().totalCommissionsEgp &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedOrdersCount',
              'totalSalesVolumeEgp',
              'totalCommissionsEgp',
              'status',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(referralId) && (
        isAdmin() ||
        existing().get('referredUid', '') == request.auth.uid
      );
    }

    function isValidCommission(data) {
      return data.keys().hasAll([
        'id',
        'orderId',
        'agentId',
        'referralCode',
        'referredEntityId',
        'referredEntityName',
        'referredEntityType',
        'orderTotalEgp',
        'commissionRatePercent',
        'amountEgp',
        'status',
        'maturesAtMs',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orderId',
        'agentId',
        'referralCode',
        'referredEntityId',
        'referredEntityName',
        'referredEntityType',
        'orderTotalEgp',
        'commissionRatePercent',
        'amountEgp',
        'status',
        'maturesAtMs',
        'settledAtIso',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.orderId) &&
      isValidId(data.agentId) &&
      data.referralCode is string && data.referralCode.size() >= 6 && data.referralCode.size() <= 24 &&
      isBoundedId(data.referredEntityId) &&
      data.referredEntityName is string && data.referredEntityName.size() >= 1 && data.referredEntityName.size() <= 80 &&
      data.referredEntityType is string && data.referredEntityType.size() <= 20 &&
      data.referredEntityType in ['store', 'customer'] &&
      data.orderTotalEgp is number && data.orderTotalEgp >= 0 && data.orderTotalEgp <= 1000000 &&
      data.commissionRatePercent is number && data.commissionRatePercent > 0 && data.commissionRatePercent <= 50 &&
      data.amountEgp is number && data.amountEgp > 0 && data.amountEgp <= 500000 &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['pending', 'settled'] &&
      data.maturesAtMs is number && data.maturesAtMs > 0 &&
      (!('settledAtIso' in data) || (data.settledAtIso is string && data.settledAtIso.size() <= 40)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /commissions/{orderId} (24h Escrow Sales Agent Commissions)
    match /commissions/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        resource == null ||
        existing().agentId == request.auth.uid ||
        isApprovedCourier() ||
        isOperationsOrAdmin()
      );
      allow list: if isSignedIn() && existing().agentId == request.auth.uid;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(orderId) &&
        isValidCommission(incoming()) &&
        incoming().id == orderId &&
        incoming().orderId == orderId &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.get('status', '') == 'delivered'
      );

      allow update: if (
        isSignedIn() &&
        isValidId(orderId) &&
        isValidCommission(incoming()) &&
        incoming().id == existing().id &&
        incoming().orderId == existing().orderId &&
        incoming().agentId == existing().agentId &&
        incoming().amountEgp == existing().amountEgp &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            existing().agentId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'settled' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'settledAtIso',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        )
      );

      allow delete: if isSignedIn() && isValidId(orderId) && isAdmin();
    }

    function isValidPayoutRequest(data) {
      return data.keys().hasAll([
        'id',
        'agentId',
        'agentName',
        'agentEmail',
        'amount',
        'method',
        'accountDetails',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'agentId',
        'agentName',
        'agentEmail',
        'amount',
        'method',
        'accountDetails',
        'status',
        'rejectionReason',
        'processedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.agentId) &&
      data.agentName is string && data.agentName.size() >= 2 && data.agentName.size() <= 80 &&
      data.agentEmail is string && data.agentEmail.size() >= 5 && data.agentEmail.size() <= 100 &&
      data.amount is number && data.amount >= 100 && data.amount <= 1000000 &&
      data.method is string && data.method.size() <= 24 &&
      data.method in ['vodafone_cash', 'instapay'] &&
      data.accountDetails is string && data.accountDetails.size() >= 4 && data.accountDetails.size() <= 120 &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['pending', 'completed', 'rejected'] &&
      (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 240)) &&
      (!('processedBy' in data) || isBoundedId(data.processedBy)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPayoutRequestIndexEntry(data) {
      return data.keys().hasAll([
        'id',
        'agentId',
        'agentName',
        'amount',
        'method',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'agentId',
        'agentName',
        'amount',
        'method',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.agentId) &&
      data.agentName is string && data.agentName.size() >= 2 && data.agentName.size() <= 80 &&
      data.amount is number && data.amount >= 100 && data.amount <= 1000000 &&
      data.method is string && data.method.size() <= 24 &&
      data.method in ['vodafone_cash', 'instapay'] &&
      data.status is string && data.status.size() <= 16 &&
      data.status in ['pending', 'completed', 'rejected'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /payout_requests/{requestId} (PII-isolated Vodafone Cash / InstaPay Withdrawals)
    match /payout_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null ||
        existing().agentId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && existing().agentId == request.auth.uid;

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(requestId) &&
        isValidPayoutRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().agentId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().amount >= 100 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isActiveSalesAgent() &&
        existsAfter(/databases/$(database)/documents/payoutRequestIndex/$(requestId))
      );

      allow update: if (
        isSignedIn() &&
        isValidId(requestId) &&
        isValidPayoutRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().agentId == existing().agentId &&
        incoming().amount == existing().amount &&
        incoming().method == existing().method &&
        incoming().accountDetails == existing().accountDetails &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'pending' &&
        incoming().status in ['completed', 'rejected'] &&
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }

    // Collection: /payoutRequestIndex/{requestId} (Non-PII operational queue for Admin live review)
    match /payoutRequestIndex/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn() && existing().status in ['pending', 'completed', 'rejected'];

      allow create: if (
        isNonAnonymousUser() &&
        isValidId(requestId) &&
        isValidPayoutRequestIndexEntry(incoming()) &&
        incoming().id == requestId &&
        incoming().agentId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().amount >= 100 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isActiveSalesAgent() &&
        existsAfter(/databases/$(database)/documents/payout_requests/$(requestId))
      );

      allow update: if (
        isSignedIn() &&
        isValidId(requestId) &&
        isValidPayoutRequestIndexEntry(incoming()) &&
        incoming().id == existing().id &&
        incoming().agentId == existing().agentId &&
        incoming().amount == existing().amount &&
        incoming().method == existing().method &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'pending' &&
        incoming().status in ['completed', 'rejected'] &&
        isAdmin()
      );

      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }

    // Blueprint Validation Helper: WalletTopupRequest (/wallet_topup_requests/{requestId})
    function isValidWalletTopupRequest(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'userName',
        'userPhone',
        'amount',
        'method',
        'senderPhone',
        'referenceNumber',
        'receiptImageUrl',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'userName',
        'userPhone',
        'amount',
        'method',
        'senderPhone',
        'referenceNumber',
        'receiptImageUrl',
        'status',
        'adminNote',
        'processedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
      data.userPhone is string && data.userPhone.size() <= 20 &&
      data.amount is number && data.amount >= 10 && data.amount <= 50000 &&
      data.method is string && data.method in ['vodafone_cash', 'instapay'] &&
      data.senderPhone is string && data.senderPhone.size() >= 4 && data.senderPhone.size() <= 40 &&
      data.referenceNumber is string && data.referenceNumber.size() >= 2 && data.referenceNumber.size() <= 80 &&
      isValidUploadedImage(data.receiptImageUrl) &&
      data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
      (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 240)) &&
      (!('processedBy' in data) || isBoundedId(data.processedBy)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /wallet_topup_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if (
        isNonAnonymousUser() &&
        isValidId(requestId) &&
        isValidWalletTopupRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        !isUserBlocked()
      );
      allow update: if (
        isSignedIn() &&
        isValidId(requestId) &&
        isValidWalletTopupRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().amount == existing().amount &&
        incoming().method == existing().method &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status == 'pending' &&
        incoming().status in ['approved', 'rejected'] &&
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }

    // Blueprint Validation Helper: WalletTransaction (/wallet_transactions/{txId})
    function isValidWalletTransaction(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'type',
        'amount',
        'balanceAfter',
        'description',
        'createdBy',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'type',
        'amount',
        'balanceAfter',
        'description',
        'orderId',
        'requestId',
        'createdBy',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.type is string && data.type in ['topup_credit', 'order_debit', 'order_refund'] &&
      data.amount is number && data.amount > 0 && data.amount <= 100000 &&
      data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 10000000 &&
      data.description is string && data.description.size() >= 2 && data.description.size() <= 200 &&
      (!('orderId' in data) || isBoundedId(data.orderId)) &&
      (!('requestId' in data) || isBoundedId(data.requestId)) &&
      isBoundedId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    match /wallet_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if (
        isNonAnonymousUser() &&
        isValidId(txId) &&
        isValidWalletTransaction(incoming()) &&
        incoming().id == txId &&
        incoming().createdAt == request.time && (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().createdBy == request.auth.uid &&
            incoming().type in ['order_debit', 'order_refund']
          )
        )
      );
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(txId) && isAdmin();
    }

    // Blueprint Validation Helper: LiveEvent (/live_events/{eventId})
    function isValidLiveEvent(data) {
      return data.keys().hasAll([
        'id',
        'text',
        'neighborhood',
        'storeName',
        'eventType',
        'createdBy',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'text',
        'neighborhood',
        'storeName',
        'eventType',
        'createdBy',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.text is string && data.text.size() >= 4 && data.text.size() <= 160 &&
      data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 60 &&
      data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
      data.eventType is string && data.eventType in ['new_order', 'promo', 'delivery'] &&
      isBoundedId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    match /live_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId);
      allow list: if isSignedIn() && existing().eventType in ['new_order', 'promo', 'delivery'];
      allow create: if (
        isNonAnonymousUser() &&
        isValidId(eventId) &&
        isValidLiveEvent(incoming()) &&
        incoming().id == eventId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        !isUserBlocked()
      );
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(eventId) && isAdmin();
    }
  }
}
