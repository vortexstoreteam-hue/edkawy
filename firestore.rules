          )
        ) || (
          (
            (inc.status == ext.status && ext.status in ['awaiting_courier_quote', 'pending', 'confirmed', 'preparing', 'ready'] && isCourierUnassignedOrSelf(ext) && 'rejectedBy' in inc && request.auth.uid in inc.rejectedBy && changed.hasOnly(['rejectedBy', 'updatedAt'])) ||
            (inc.status == 'ready' && ext.status in ['on_the_way', 'delivering'] && isCourierExplicitlySelf(ext) && inc.get('courierId', '') == '' && changed.hasOnly(['status', 'courierId', 'courierName', 'courierLat', 'courierLng', 'cancelledByCourierIds', 'updatedAt'])) ||
            (inc.status == 'awaiting_courier_quote' && ext.status in ['awaiting_customer_errand_approval', 'on_the_way', 'delivering'] && ext.get('orderType', '') == 'custom_errand' && isCourierExplicitlySelf(ext) && inc.get('courierId', '') == '' && changed.hasOnly(['status', 'courierId', 'courierName', 'courierLat', 'courierLng', 'cancelledByCourierIds', 'updatedAt'])) ||
            (inc.status in ['on_the_way', 'delivering'] && inc.get('courierId', '') == request.auth.uid && (ext.status == 'ready' ? isCourierUnassignedOrSelf(ext) : (ext.status in ['pending', 'preparing', 'on_the_way', 'delivering'] && isCourierExplicitlySelf(ext))) && changed.hasOnly(['status', 'courierId', 'courierName', 'courierLat', 'courierLng', 'updatedAt'])) ||
            (inc.status == 'delivered' && inc.get('courierId', '') == request.auth.uid && (ext.status == 'ready' ? isCourierUnassignedOrSelf(ext) : (ext.status in ['pending', 'preparing', 'on_the_way', 'delivering'] && isCourierExplicitlySelf(ext))) && changed.hasOnly(['status', 'courierId', 'courierName', 'courierLat', 'courierLng', 'updatedAt'])) ||
            (inc.status == 'awaiting_customer_errand_approval' && ext.status in ['awaiting_courier_quote', 'awaiting_customer_errand_approval'] && inc.get('courierId', '') == request.auth.uid && isCourierUnassignedOrSelf(ext) && changed.hasOnly(['status', 'deliveryFee', 'totalAmount', 'courierId', 'courierName', 'courierLat', 'courierLng', 'updatedAt']))
          ) && isApprovedCourier()
        )
      );
    }

    // Blueprint Validation Helper: Courier (Private PII)
    function isValidCourier(data) {
      return data.keys().hasAll([
        'name',
        'phone',
        'vehicleType',
        'neighborhood',
        'isAvailable',
        'completedDeliveries',
        'updatedBy',
        'updatedAt'
