      (!('lng' in data) || data.lng is number) &&
      (!('commercialRegisterImage' in data) || (data.commercialRegisterImage is string && data.commercialRegisterImage.size() <= 1000000)) &&
      (!('ownerUid' in data) || isBoundedId(data.ownerUid)) &&
      (!('rejectReason' in data) || (data.rejectReason is string && data.rejectReason.size() <= 300)) &&
      data.status in ['pending', 'approved', 'rejected'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidChatLog(data) {
      return data.keys().hasAll(['userId', 'userMessage', 'assistantReply', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userMessage', 'assistantReply', 'suggestedStoreId', 'pointsSnapshot', 'createdAt']) &&
        isBoundedId(data.userId) &&
