      (!('zoneName' in data) || data.zoneName == null || (data.zoneName is string && data.zoneName.size() <= 80)) &&
      (!('smallOrderFee' in data) || data.smallOrderFee == null || (data.smallOrderFee is number && data.smallOrderFee >= 0 && data.smallOrderFee <= 20)) &&
      (!('groupSessionId' in data) || data.groupSessionId == null || (data.groupSessionId is string && data.groupSessionId.size() <= 128)) &&
      (!('rejectedBy' in data) || data.rejectedBy == null || (data.rejectedBy is list && data.rejectedBy.size() <= 30 && (data.rejectedBy.size() == 0 || (data.rejectedBy[0] is string && data.rejectedBy[0].size() <= 128)))) &&
      (!('tipAmountEgp' in data) || data.tipAmountEgp == null || (data.tipAmountEgp is number && data.tipAmountEgp in [0, 5, 10, 15])) &&
