                get(/databases/$(database)/documents/orders/$(incoming().lastRefundOrderId)).data.get('status', '') != 'cancelled' &&
                getAfter(/databases/$(database)/documents/orders/$(incoming().lastRefundOrderId)).data.get('status', '') == 'cancelled' &&
                incoming().walletBalance == existing().get('walletBalance', 0) + get(/databases/$(database)/documents/orders/$(incoming().lastRefundOrderId)).data.totalAmount
