    function isCourierUnassignedOrSelf(ext) {
      return !('courierId' in ext) ||
        ext.courierId == null ||
        ext.courierId == '' ||
        ext.courierId == request.auth.uid;
    }

    function isCourierExplicitlySelf(ext) {
      return 'courierId' in ext && ext.courierId == request.auth.uid;
    }

    // Consolidated by role (static checks precede DB reads to preserve 10-get/20-batch budget)
    function isAllowedOrderTransition(orderId, inc, ext, changed) {
      return ext.status != 'cancelled' && (
        (
          ext.customerId == request.auth.uid && (
            (
              ext.status == 'delivered' &&
              inc.status == 'delivered' && (
                (!('isReviewed' in ext && ext.isReviewed == true) && inc.get('isReviewed', false) == true && changed.hasOnly(['isReviewed', 'updatedAt']) && existsAfter(/databases/$(database)/documents/reviews/$(orderId))) ||
                (!('isTipped' in ext && ext.isTipped == true) && inc.get('isTipped', false) == true && inc.get('tipAmountEgp', 0) in [5, 10, 15] && changed.hasOnly(['tipAmountEgp', 'isTipped', 'updatedAt'])) ||
                changed.hasOnly(['pointsEarned', 'pointsAwarded', 'updatedAt'])
              )
            ) || (
              ext.status == 'pending' &&
              inc.status in ['confirmed', 'pending_payment'] &&
              changed.hasOnly(['status', 'updatedAt'])
            ) || (
              inc.status == 'preparing' &&
              ext.status in ['awaiting_customer_approval', 'preparing'] &&
              changed.hasOnly(['status', 'updatedAt'])
            ) || (
              inc.status == 'on_the_way' &&
              ext.status in ['awaiting_customer_errand_approval', 'on_the_way'] &&
              changed.hasOnly(['status', 'updatedAt'])
            ) || (
              inc.status == 'cancelled' &&
              ext.status in ['pending', 'confirmed', 'pending_payment', 'awaiting_pharmacy_quote', 'awaiting_customer_approval', 'awaiting_courier_quote', 'awaiting_customer_errand_approval'] &&
              changed.hasOnly(['status', 'updatedAt'])
            )
          )
        ) || (
          ext.status != 'delivered' &&
          inc.status in ['preparing', 'ready', 'cancelled', 'awaiting_customer_approval'] &&
          !('courierId' in changed) &&
          !('rejectedBy' in changed) &&
          isMerchantOfOrder(ext) && (
            (inc.status == 'preparing' && ext.status in ['pending', 'confirmed', 'preparing'] && changed.hasOnly(['status', 'prepTimeMinutes', 'updatedAt'])) ||
            (inc.status == 'ready' && ext.status in ['pending', 'confirmed', 'preparing', 'ready'] && changed.hasOnly(['status', 'updatedAt'])) ||
            (inc.status == 'cancelled' && ext.status in ['awaiting_pharmacy_quote', 'awaiting_customer_approval', 'pending', 'confirmed', 'pending_payment', 'preparing', 'ready'] && changed.hasOnly(['status', 'pharmacistNote', 'updatedAt'])) ||
            (inc.status == 'awaiting_customer_approval' && ext.status in ['awaiting_pharmacy_quote', 'awaiting_customer_approval'] && inc.subtotal > 0 && inc.totalAmount == inc.subtotal + ext.deliveryFee && changed.hasOnly(['status', 'subtotal', 'totalAmount', 'pharmacistNote', 'items', 'itemsSummary', 'itemNames', 'prepTimeMinutes', 'updatedAt']))
          )
        ) || (
          (
            (ext.status == 'delivered' && inc.status == 'delivered' && isCourierExplicitlySelf(ext) && changed.hasOnly(['pointsEarned', 'pointsAwarded', 'updatedAt'])) ||
            (inc.status == ext.status && ext.status in ['awaiting_courier_quote', 'pending', 'confirmed', 'preparing', 'ready'] && isCourierUnassignedOrSelf(ext) && 'rejectedBy' in inc && request.auth.uid in inc.rejectedBy && changed.hasOnly(['rejectedBy', 'updatedAt'])) ||
            (inc.status == 'ready' && ext.status in ['on_the_way', 'delivering'] && isCourierExplicitlySelf(ext) && inc.get('courierId', '') == '' && changed.hasOnly(['status', 'courierId', 'courierName', 'courierPhone', 'courierLocation', 'courierLat', 'courierLng', 'cancelledByCourierIds', 'updatedAt'])) ||
            (inc.status == 'awaiting_courier_quote' && ext.status in ['awaiting_customer_errand_approval', 'on_the_way', 'delivering'] && ext.get('orderType', '') == 'custom_errand' && isCourierExplicitlySelf(ext) && inc.get('courierId', '') == '' && changed.hasOnly(['status', 'courierId', 'courierName', 'courierPhone', 'courierLocation', 'courierLat', 'courierLng', 'cancelledByCourierIds', 'updatedAt'])) ||
            (inc.status in ['on_the_way', 'delivering'] && inc.get('courierId', '') == request.auth.uid && (ext.status == 'ready' ? isCourierUnassignedOrSelf(ext) : (ext.status in ['pending', 'preparing', 'on_the_way', 'delivering'] && isCourierExplicitlySelf(ext))) && changed.hasOnly(['status', 'courierId', 'courierName', 'courierPhone', 'courierLocation', 'courierLat', 'courierLng', 'updatedAt'])) ||
            (inc.status == 'delivered' && ext.status in ['pending', 'preparing', 'ready', 'on_the_way', 'delivering'] && inc.get('courierId', '') == request.auth.uid && (ext.status == 'ready' ? isCourierUnassignedOrSelf(ext) : isCourierExplicitlySelf(ext)) && changed.hasOnly(['status', 'courierId', 'courierName', 'courierPhone', 'courierLocation', 'courierLat', 'courierLng', 'pointsEarned', 'pointsAwarded', 'updatedAt'])) ||
            (inc.status == 'awaiting_customer_errand_approval' && ext.status in ['awaiting_courier_quote', 'awaiting_customer_errand_approval'] && inc.get('deliveryFee', 0) >= 10 && inc.get('deliveryFee', 0) <= 500 && inc.totalAmount == inc.deliveryFee && inc.get('courierId', '') == request.auth.uid && isCourierUnassignedOrSelf(ext) && changed.hasOnly(['status', 'deliveryFee', 'totalAmount', 'courierId', 'courierName', 'courierPhone', 'courierLocation', 'courierLat', 'courierLng', 'updatedAt']))
          ) && isApprovedCourier()
        )
      );
    }

    function isAllowedDispatchTransition(inc, ext, changed) {
      return !(ext.status in ['delivered', 'cancelled']) && (
        (
          ext.customerId == request.auth.uid && (
            (ext.status == 'pending' && inc.status in ['confirmed', 'pending_payment'] && changed.hasOnly(['status', 'updatedAt'])) ||
            (inc.status == 'preparing' && ext.status in ['awaiting_customer_approval', 'preparing'] && changed.hasOnly(['status', 'updatedAt'])) ||
            (inc.status == 'on_the_way' && ext.status in ['awaiting_customer_errand_approval', 'on_the_way'] && changed.hasOnly(['status', 'updatedAt'])) ||
            (inc.status == 'cancelled' && ext.status in ['pending', 'confirmed', 'pending_payment', 'awaiting_pharmacy_quote', 'awaiting_customer_approval', 'awaiting_courier_quote', 'awaiting_customer_errand_approval'] && changed.hasOnly(['status', 'updatedAt']))
          )
        ) || (
          inc.status in ['preparing', 'ready', 'cancelled', 'awaiting_customer_approval'] &&
          !('courierId' in changed) &&
          !('rejectedBy' in changed) &&
          isMerchantOfOrder(ext) && (
            (inc.status == 'preparing' && ext.status in ['pending', 'confirmed', 'preparing'] && changed.hasOnly(['status', 'prepTimeMinutes', 'updatedAt'])) ||
            (inc.status == 'ready' && ext.status in ['pending', 'confirmed', 'preparing', 'ready'] && changed.hasOnly(['status', 'updatedAt'])) ||
            (inc.status == 'cancelled' && ext.status in ['awaiting_pharmacy_quote', 'awaiting_customer_approval', 'pending', 'confirmed', 'pending_payment', 'preparing', 'ready'] && changed.hasOnly(['status', 'pharmacistNote', 'updatedAt'])) ||
