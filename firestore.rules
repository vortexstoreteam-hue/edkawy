        'vehicleType',
        'neighborhood',
        'lat',
        'lng',
        'rating',
        'reviewCount',
        'ratingSum',
        'isAvailable',
        'approvalStatus',
        'completedDeliveries',
        'cancelledDeliveries',
        'walletBalance',
        'totalTipsEgp',
        'createdAt',
        'updatedBy',
        'updatedAt'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
      ('email' in data ? (data.email is string && data.email.size() >= 3 && data.email.size() <= 100) : true) &&
      data.vehicleType is string && data.vehicleType.size() <= 30 &&
      data.vehicleType in ['دراجة نارية', 'سكوتر كهربائي', 'دراجة هوائية'] &&
      data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 80 &&
      ('lat' in data ? isValidEdkuLat(data.lat) : true) &&
      ('lng' in data ? isValidEdkuLng(data.lng) : true) &&
      ('rating' in data ? (data.rating is number && data.rating >= 1 && data.rating <= 5) : true) &&
      ('reviewCount' in data ? (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 1000000) : true) &&
      ('ratingSum' in data ? (data.ratingSum is number && data.ratingSum >= 0 && data.ratingSum <= 5000000) : true) &&
      data.isAvailable is bool &&
      ('approvalStatus' in data ? (data.approvalStatus is string && data.approvalStatus.size() <= 20 && data.approvalStatus in ['pending', 'approved', 'rejected']) : true) &&
      data.completedDeliveries is number && data.completedDeliveries >= 0 && data.completedDeliveries <= 100000 &&
      ('cancelledDeliveries' in data ? (data.cancelledDeliveries is number && data.cancelledDeliveries >= 0 && data.cancelledDeliveries <= 100000) : true) &&
      ('walletBalance' in data ? (data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 10000000) : true) &&
      ('totalTipsEgp' in data ? (data.totalTipsEgp is number && data.totalTipsEgp >= 0 && data.totalTipsEgp <= 10000000) : true) &&
      ('createdAt' in data ? data.createdAt is timestamp : true) &&
      isBoundedId(data.updatedBy) &&
      data.updatedAt is timestamp;
    }

