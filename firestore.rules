    function orderSmallFee(data) {
      return 'smallOrderFee' in data ? data.smallOrderFee : 0;
    }

    function isStrictNewOrderCreate(data) {
      return data.keys().hasAll([
        'items',
        'itemsSummary',
        'itemNames',
        'itemCount',
        'subtotal',
        'deliveryFee',
        'notes',
        'updatedAt'
      ]) &&
      (
        data.paymentMethod in ['cash', 'wallet', 'cash_on_delivery'] ||
        (data.paymentMethod == 'visa' && data.status == 'pending_payment')
      ) &&
      isValidEgyptPhone(data.customerPhone) &&
      data.deliveryAddress.size() >= 4 &&
      data.items.size() >= 1 &&
      data.subtotal > 0 &&
      (!('smallOrderFee' in data) || (data.smallOrderFee is number && data.smallOrderFee >= 0 && data.smallOrderFee <= 20)) &&
      (
        'discountAmount' in data
          ? (
               data.discountAmount <= data.subtotal &&
               data.totalAmount == (data.subtotal - data.discountAmount) + data.deliveryFee + orderSmallFee(data)
            )
          : (data.totalAmount == data.subtotal + data.deliveryFee + orderSmallFee(data))
      );
    }

    function isStrictPharmacyOrderCreate(data) {
      return 'orderType' in data &&
        data.orderType == 'pharmacy_prescription' &&
