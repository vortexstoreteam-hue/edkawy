rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives (CEL & RE2 budget optimized)
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHexHash(h) {
      return h is string && h.size() == 64 && h.matches('^[a-f0-9]+$');
    }

    function isBoundedId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function isValidEgyptPhone(phone) {
      return phone is string && phone.size() == 11 && phone.matches('^01[0125][0-9]+$');
    }

    function isValidCustomerCode(code) {
      return code is string && code.size() == 12 && code.matches('^EDK-USR-[0-9]{4}$');
    }

    function isValidEdkuLat(lat) {
      return lat is number && lat >= -90 && lat <= 90;
    }

    function isValidEdkuLng(lng) {
      return lng is number && lng >= -180 && lng <= 180;
    }

    // O(1) slice prefix check for device-uploaded Data URLs (<= 750KB) or HTTPS URLs (zero RE2 regex cost)
    function isValidUploadedImage(url) {
      return url is string &&
        url.size() >= 16 &&
        url.size() <= 750000 &&
        (
          url[0:11] == 'data:image/' ||
          url[0:8] == 'https://' ||
          url[0:7] == 'http://'
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null &&
        request.auth.uid is string &&
        request.auth.uid.size() >= 1 &&
        request.auth.uid.size() <= 128;
    }

    function isNonAnonymousUser() {
      return isSignedIn() && (
        'firebase' in request.auth.token && 'sign_in_provider' in request.auth.token.firebase
          ? request.auth.token.firebase.sign_in_provider != 'anonymous'
          : true
      );
    }

    function staffDocMatchesRoles(staffData, roles) {
      return staffData.get('isActive', false) == true &&
        staffData.get('role', '') in roles;
    }

    function isStaffRoleIn(roles) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        staffDocMatchesRoles(
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data,
          roles
        );
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        (
          'email' in request.auth.token &&
          (
            request.auth.token.email in ['vortexstore.team@gmail.com', 'alaslybys46@gmail.com'] ||
            request.auth.token.email.lower() in ['vortexstore.team@gmail.com', 'alaslybys46@gmail.com']
          ) &&
          ('email_verified' in request.auth.token ? request.auth.token.email_verified == true : true)
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isStaffRoleIn(['super_admin']);
    }

    function isSupportStaff() {
      return isStaffRoleIn(['support_agent', 'super_admin']);
    }

    function isOperationsStaff() {
      return isStaffRoleIn(['operations', 'super_admin']);
    }

    function isOperationsOrAdmin() {
      return isBootstrappedAdmin() || isStaffRoleIn(['operations', 'super_admin']);
    }

    function isSupportOrAdmin() {
      return isBootstrappedAdmin() || isStaffRoleIn(['support_agent', 'super_admin']);
    }

    function isActiveSalesAgent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sales_agents/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sales_agents/$(request.auth.uid)).data.get('isActive', false) == true;
    }

    function isPendingInviteDataMatching(inviteBefore, inviteAfter, expectedUserType) {
      return inviteBefore.get('status', '') == 'pending' &&
        inviteBefore.get('userType', '') == expectedUserType &&
        inviteAfter.get('status', '') == 'accepted' &&
        inviteAfter.get('acceptedByUid', '') == request.auth.uid;
    }

    function isValidPendingInviteAcceptance(tokenValue, expectedUserType) {
      return isValidId(tokenValue) &&
        tokenValue.size() >= 16 &&
        exists(/databases/$(database)/documents/invitations/$(tokenValue)) &&
        existsAfter(/databases/$(database)/documents/invitations/$(tokenValue)) &&
        isPendingInviteDataMatching(
          get(/databases/$(database)/documents/invitations/$(tokenValue)).data,
          getAfter(/databases/$(database)/documents/invitations/$(tokenValue)).data,
          expectedUserType
        );
    }

    function isSystemInMaintenance() {
      return exists(/databases/$(database)/documents/appConfig/system) &&
        get(/databases/$(database)/documents/appConfig/system).data.get('maintenanceMode', false) == true;
    }

    function isUserBlocked() {
      return (
        exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)).data.get('isBlocked', false) == true
      ) || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true
      );
    }

    function isBlockedUserEntry() {
      return exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)).data.get('isBlocked', false) == true;
    }

    function isStoreBlocked(targetStoreId) {
      return isBoundedId(targetStoreId) &&
        exists(/databases/$(database)/documents/blockedUsers/$(targetStoreId)) &&
        get(/databases/$(database)/documents/blockedUsers/$(targetStoreId)).data.get('isBlocked', false) == true;
    }

    function storeDocOwnedBy(storeData, candidateUid) {
      return storeData.get('ownerUid', '') == candidateUid ||
        storeData.get('createdBy', '') == candidateUid;
    }

    function isStoreOwnerUid(targetStoreId, candidateUid) {
      return isBoundedId(targetStoreId) &&
        exists(/databases/$(database)/documents/stores/$(targetStoreId)) &&
        storeDocOwnedBy(
          get(/databases/$(database)/documents/stores/$(targetStoreId)).data,
          candidateUid
        );
    }

    function isStoreOwnerOf(targetStoreId) {
      return isStoreOwnerUid(targetStoreId, request.auth.uid);
    }

    function isCourierDocApproved(courierData) {
      return courierData != null && (
        ('approvalStatus' in courierData)
          ? !(courierData.approvalStatus in ['pending', 'rejected'])
          : true
      );
    }

    function isApprovedCourier() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/courierDirectory/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/courierDirectory/$(request.auth.uid)).data.get('approvalStatus', '') == 'approved'
        ) ||
        (
          exists(/databases/$(database)/documents/couriers/$(request.auth.uid)) &&
          !(get(/databases/$(database)/documents/couriers/$(request.auth.uid)).data.get('approvalStatus', 'approved') in ['pending', 'rejected'])
        )
      );
    }

    function isOrderParticipant(data) {
      return data.customerId == request.auth.uid ||
        ('storeOwnerId' in data ? data.storeOwnerId == request.auth.uid : false) ||
        ('courierId' in data ? data.courierId == request.auth.uid : false);
    }

    function isMerchantOfOrder(data) {
      return ('storeOwnerId' in data ? data.storeOwnerId == request.auth.uid : false) ||
        isStoreOwnerOf(data.storeId);
    }

    function isValidFirstSavedAddress(addr) {
      return addr is map &&
        addr.keys().hasAll(['id', 'label', 'neighborhood', 'address']) &&
        addr.keys().hasOnly(['id', 'label', 'neighborhood', 'address', 'lat', 'lng', 'isDefault']) &&
        addr.id is string && addr.id.size() >= 1 && addr.id.size() <= 64 &&
        addr.label is string && addr.label.size() >= 1 && addr.label.size() <= 40 &&
        addr.neighborhood is string && addr.neighborhood.size() >= 2 && addr.neighborhood.size() <= 80 &&
        addr.address is string && addr.address.size() >= 4 && addr.address.size() <= 220 &&
        ('lat' in addr ? isValidEdkuLat(addr.lat) : true) &&
        ('lng' in addr ? isValidEdkuLng(addr.lng) : true) &&
        ('isDefault' in addr ? addr.isDefault is bool : true);
    }

    // Blueprint Validation Helper: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll(['role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'role',
          'customerCode',
          'referralCode',
          'referredByCode',
          'referredByAgentId',
          'customerReferralCode',
          'requiresEmailVerification',
          'lastReviewPromptAtIso',
          'isBanned',
          'banType',
          'banUntilIso',
          'banReason',
          'email',
          'name',
          'phone',
          'defaultNeighborhood',
          'defaultAddress',
          'defaultLat',
          'defaultLng',
          'profileCompleted',
          'favoriteStoreIds',
          'savedAddresses',
          'darkMode',
          'storeId',
          'points',
          'walletBalance',
          'totalSpentEgp',
          'lastRefundOrderId',
          'currentStreak',
          'freeDeliveryRewards',
          'lastDeliveredOrderAtIso',
          'lastSpinDate',
          'createdAt',
          'updatedAt'
        ]) &&
        data.role is string && data.role.size() <= 20 &&
        data.role in ['admin', 'store', 'courier', 'customer', 'sales_agent', 'support_agent', 'operations'] &&
        ('customerCode' in data ? isValidCustomerCode(data.customerCode) : true) &&
        ('isBanned' in data ? data.isBanned is bool : true) &&
        ('banReason' in data ? (data.banReason is string && data.banReason.size() <= 240) : true) &&
        ('email' in data ? (data.email is string && data.email.size() <= 100) : true) &&
        ('name' in data ? (data.name is string && data.name.size() <= 80) : true) &&
        ('phone' in data ? (data.phone is string && data.phone.size() <= 20) : true) &&
        ('defaultNeighborhood' in data ? (data.defaultNeighborhood is string && data.defaultNeighborhood.size() <= 80) : true) &&
        ('defaultAddress' in data ? (data.defaultAddress is string && data.defaultAddress.size() <= 220) : true) &&
        ('defaultLat' in data ? isValidEdkuLat(data.defaultLat) : true) &&
        ('defaultLng' in data ? isValidEdkuLng(data.defaultLng) : true) &&
        ('profileCompleted' in data ? data.profileCompleted is bool : true) &&
        ('favoriteStoreIds' in data ? (data.favoriteStoreIds is list && data.favoriteStoreIds.size() <= 50 && (data.favoriteStoreIds.size() == 0 || (data.favoriteStoreIds[0] is string && data.favoriteStoreIds[0].size() <= 128))) : true) &&
        ('savedAddresses' in data ? (data.savedAddresses is list && data.savedAddresses.size() <= 10 && (data.savedAddresses.size() == 0 || isValidFirstSavedAddress(data.savedAddresses[0]))) : true) &&
        ('darkMode' in data ? data.darkMode is bool : true) &&
        ('storeId' in data ? isBoundedId(data.storeId) : true) &&
        ('points' in data ? (data.points is number && data.points >= 0 && data.points <= 10000000) : true) &&
        ('currentStreak' in data ? (data.currentStreak is number && data.currentStreak >= 0 && data.currentStreak <= 5) : true) &&
        ('freeDeliveryRewards' in data ? (data.freeDeliveryRewards is number && data.freeDeliveryRewards >= 0 && data.freeDeliveryRewards <= 10000) : true) &&
        ('lastDeliveredOrderAtIso' in data ? (data.lastDeliveredOrderAtIso is string && data.lastDeliveredOrderAtIso.size() <= 40) : true) &&
        ('lastSpinDate' in data ? (data.lastSpinDate is string && data.lastSpinDate.size() <= 40) : true) &&
        (
          !data.keys().hasAny([
            'referralCode',
            'referredByCode',
            'referredByAgentId',
            'customerReferralCode',
            'requiresEmailVerification',
            'lastReviewPromptAtIso',
            'banType',
            'banUntilIso',
            'walletBalance',
            'totalSpentEgp',
            'lastRefundOrderId'
          ]) || (
            (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 24)) &&
            (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 24)) &&
            (!('referredByAgentId' in data) || isBoundedId(data.referredByAgentId)) &&
            (!('customerReferralCode' in data) || (data.customerReferralCode is string && data.customerReferralCode.size() <= 24)) &&
            (!('requiresEmailVerification' in data) || data.requiresEmailVerification is bool) &&
            (!('lastReviewPromptAtIso' in data) || (data.lastReviewPromptAtIso is string && data.lastReviewPromptAtIso.size() <= 40)) &&
            (!('banType' in data) || (data.banType is string && data.banType in ['temporary_24h', 'suspended', 'permanent'])) &&
            (!('banUntilIso' in data) || (data.banUntilIso is string && data.banUntilIso.size() <= 40)) &&
            (!('walletBalance' in data) || (data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 10000000)) &&
            (!('totalSpentEgp' in data) || (data.totalSpentEgp is number && data.totalSpentEgp >= 0 && data.totalSpentEgp <= 10000000)) &&
            (!('lastRefundOrderId' in data) || isBoundedId(data.lastRefundOrderId))
          )
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'name', 'points', 'currentStreak', 'totalDeliveredOrders', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'customerCode',
          'isBanned',
          'banType',
          'banUntilIso',
          'banReason',
          'neighborhood',
          'points',
          'totalSpentEgp',
          'currentStreak',
          'freeDeliveryRewards',
          'totalDeliveredOrders',
          'lastDeliveredOrderAtIso',
          'updatedAt'
        ]) &&
        isBoundedId(data.uid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        ('customerCode' in data ? isValidCustomerCode(data.customerCode) : true) &&
        ('isBanned' in data ? data.isBanned is bool : true) &&
        ('banType' in data ? (data.banType is string && data.banType in ['temporary_24h', 'suspended', 'permanent']) : true) &&
        ('banUntilIso' in data ? (data.banUntilIso is string && data.banUntilIso.size() <= 40) : true) &&
        ('banReason' in data ? (data.banReason is string && data.banReason.size() <= 240) : true) &&
        ('neighborhood' in data ? (data.neighborhood is string && data.neighborhood.size() <= 80) : true) &&
        data.points is number && data.points >= 0 && data.points <= 10000000 &&
        ('totalSpentEgp' in data ? (data.totalSpentEgp is number && data.totalSpentEgp >= 0 && data.totalSpentEgp <= 10000000) : true) &&
        data.currentStreak is number && data.currentStreak >= 0 && data.currentStreak <= 5 &&
        ('freeDeliveryRewards' in data ? (data.freeDeliveryRewards is number && data.freeDeliveryRewards >= 0 && data.freeDeliveryRewards <= 10000) : true) &&
        data.totalDeliveredOrders is number && data.totalDeliveredOrders >= 0 && data.totalDeliveredOrders <= 1000000 &&
        ('lastDeliveredOrderAtIso' in data ? (data.lastDeliveredOrderAtIso is string && data.lastDeliveredOrderAtIso.size() <= 40) : true) &&
        data.updatedAt is timestamp;
    }

    function isVerifiedSelfRoleAssignment(userId, data) {
      return userId == request.auth.uid && (
        data.role == 'customer' ||
        (
          data.role == 'admin' && (
            exists(/databases/$(database)/documents/admins/$(userId)) ||
            existsAfter(/databases/$(database)/documents/admins/$(userId))
          )
        ) ||
        (
          data.role == 'courier' && (
            exists(/databases/$(database)/documents/couriers/$(userId)) ||
            existsAfter(/databases/$(database)/documents/couriers/$(userId))
          )
        ) ||
        (
          data.role == 'store' &&
          'storeId' in data &&
          isBoundedId(data.storeId) && (
            isStoreOwnerUid(data.storeId, userId) ||
            (
              existsAfter(/databases/$(database)/documents/stores/$(data.storeId)) &&
              getAfter(/databases/$(database)/documents/stores/$(data.storeId)).data.get('ownerUid', '') == userId
            )
          )
        ) ||
        (
          data.role == 'sales_agent' && (
            exists(/databases/$(database)/documents/sales_agents/$(userId)) ||
            existsAfter(/databases/$(database)/documents/sales_agents/$(userId))
          )
        ) ||
        (
          data.role in ['support_agent', 'operations'] &&
          exists(/databases/$(database)/documents/staff/$(userId)) &&
          get(/databases/$(database)/documents/staff/$(userId)).data.get('isActive', false) == true &&
          get(/databases/$(database)/documents/staff/$(userId)).data.get('role', '') in ['support_agent', 'operations']
        )
      );
    }

    // Blueprint Validation Helper: AdminRecord
    function isValidAdminEmailValue(email) {
      return email in [
        'vortexstore.team@gmail.com',
        'alaslybys46@gmail.com',
        'vortexstore.admin@adkawy.com'
      ] || (email.size() >= 25 && email[0:18] == 'vortexstore.admin.');
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['role', 'email', 'activationGate', 'createdAt']) &&
        data.keys().hasOnly(['role', 'email', 'activationGate', 'createdAt']) &&
        data.role is string && data.role.size() <= 16 && data.role == 'admin' &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
        isValidAdminEmailValue(data.email) &&
        data.activationGate is string && data.activationGate.size() >= 10 && data.activationGate.size() <= 80 &&
        data.createdAt is timestamp;
    }

    function isValidBootstrapConfig(data) {
      return data.keys().hasAll(['adminUid', 'updatedAt']) &&
        data.keys().hasOnly(['adminUid', 'updatedAt']) &&
        isValidId(data.adminUid) &&
        data.updatedAt is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['maintenanceMode', 'maintenanceMessage', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly([
          'maintenanceMode',
          'maintenanceMessage',
          'surgeEnabled',
          'surgeMultiplier',
          'smtpEnabled',
          'paymentMethods',
          'updatedBy',
          'updatedAt'
        ]) &&
        data.maintenanceMode is bool &&
        data.maintenanceMessage is string && data.maintenanceMessage.size() >= 2 && data.maintenanceMessage.size() <= 300 &&
        (!('surgeEnabled' in data) || data.surgeEnabled is bool) &&
        (!('surgeMultiplier' in data) || (data.surgeMultiplier is number && data.surgeMultiplier >= 1 && data.surgeMultiplier <= 3)) &&
        (!('smtpEnabled' in data) || data.smtpEnabled is bool) &&
        (!('paymentMethods' in data) || (
          data.paymentMethods is map &&
          data.paymentMethods.keys().hasOnly(['cash', 'wallet', 'visa'])
        )) &&
        isBoundedId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidAuditIndexConfig(data) {
      return data.keys().hasAll(['recentLogIds', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['recentLogIds', 'updatedBy', 'updatedAt']) &&
        data.recentLogIds is list && data.recentLogIds.size() <= 200 &&
        (data.recentLogIds.size() == 0 || (data.recentLogIds[0] is string && data.recentLogIds[0].size() <= 128)) &&
        isBoundedId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidAppConfig(configId, data) {
      return (configId == 'bootstrap' && isValidBootstrapConfig(data)) ||
        (configId == 'system' && isValidSystemConfig(data)) ||
        (configId == 'auditIndex' && isValidAuditIndexConfig(data));
    }

    function isValidBlockedEntity(data) {
      return data.keys().hasAll(['targetId', 'targetType', 'targetName', 'reason', 'isBlocked', 'blockedBy', 'updatedAt']) &&
        data.keys().hasOnly(['targetId', 'targetType', 'targetName', 'reason', 'isBlocked', 'blockedBy', 'updatedAt']) &&
        isBoundedId(data.targetId) &&
        data.targetType is string && data.targetType.size() <= 16 && data.targetType in ['customer', 'courier', 'store'] &&
        data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 100 &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 240 &&
        data.isBlocked is bool &&
        isBoundedId(data.blockedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidFirstMenuItem(item) {
      return item is map &&
        item.keys().hasAll(['id', 'name', 'price']) &&
        item.keys().hasOnly(['id', 'name', 'price']) &&
        item.id is string && item.id.size() >= 1 && item.id.size() <= 64 &&
        item.name is string && item.name.size() >= 2 && item.name.size() <= 80 &&
        item.price is number && item.price > 0 && item.price <= 5000;
    }

    // Blueprint Validation Helper: Store
    function isValidStore(data) {
      return data.keys().hasAll([
        'name',
        'category',
        'neighborhood',
        'description',
        'deliveryFee',
        'deliveryTimeMinutes',
        'rating',
        'imageKey',
        'isActive',
        'menuItems',
        'createdBy',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'name',
        'category',
        'categoryId',
        'isHomeFood',
        'neighborhood',
        'description',
        'deliveryFee',
        'deliveryTimeMinutes',
        'rating',
        'reviewCount',
        'ratingSum',
        'lat',
        'lng',
        'imageKey',
        'imageUrl',
        'isActive',
        'isOpen',
        'openingTime',
        'closingTime',
        'isManuallyClosed',
        'prepTimeMinutes',
        'minOrderAmount',
        'menuItems',
        'ownerUid',
        'loginEmail',
        'referredByAgentId',
        'referredByCode',
        'inviteToken',
        'createdBy',
        'createdAt'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.category is string && data.category.size() <= 40 &&
      data.category in [
        'أسماك وبحريات',
        'مشويات ومطاعم',
        'مخابز وفطائر',
        'سوبر ماركت',
        'صيدليات',
        'أكل بيتي',
        'مستحضرات تجميل',
        'أدوات منزلية',
        'ملابس',
        'هدايا وإكسسوارات'
      ] &&
      ('categoryId' in data ? (data.categoryId is string && data.categoryId.size() <= 40) : true) &&
      ('isHomeFood' in data ? data.isHomeFood is bool : true) &&
      data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 80 &&
      data.description is string && data.description.size() >= 2 && data.description.size() <= 300 &&
      data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 250 &&
      data.deliveryTimeMinutes is number && data.deliveryTimeMinutes >= 10 && data.deliveryTimeMinutes <= 120 &&
      data.rating is number && data.rating >= 0 && data.rating <= 5 &&
      ('reviewCount' in data ? (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 1000000) : true) &&
      ('ratingSum' in data ? (data.ratingSum is number && data.ratingSum >= 0 && data.ratingSum <= 5000000) : true) &&
      ('lat' in data ? isValidEdkuLat(data.lat) : true) &&
      ('lng' in data ? isValidEdkuLng(data.lng) : true) &&
      data.imageKey is string && data.imageKey.size() <= 24 &&
      data.imageKey in [
        'seafood',
        'grills',
        'bakery',
        'grocery',
        'pharmacy',
        'home_food',
        'cosmetics',
        'household',
        'clothing',
        'gifts'
      ] &&
      ('imageUrl' in data ? isValidUploadedImage(data.imageUrl) : true) &&
      data.isActive is bool &&
      ('isOpen' in data ? data.isOpen is bool : true) &&
      ('openingTime' in data ? (data.openingTime is string && data.openingTime.size() <= 10) : true) &&
      ('closingTime' in data ? (data.closingTime is string && data.closingTime.size() <= 10) : true) &&
      ('isManuallyClosed' in data ? data.isManuallyClosed is bool : true) &&
      ('prepTimeMinutes' in data ? (data.prepTimeMinutes is number && data.prepTimeMinutes >= 5 && data.prepTimeMinutes <= 180) : true) &&
      ('minOrderAmount' in data ? (data.minOrderAmount is number && data.minOrderAmount <= 5000 && data.minOrderAmount >= 0) : true) &&
      data.menuItems is list && data.menuItems.size() >= 1 && data.menuItems.size() <= 25 &&
      isValidFirstMenuItem(data.menuItems[0]) &&
